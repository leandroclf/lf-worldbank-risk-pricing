{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "lf-worldbank-risk-pricing",
    "description": "Coleção completa de requests para a API de scoring de risco-país e pricing dinâmico regional.\n\nUtiliza dados do World Bank (CC BY 4.0) para calcular scores de risco e gerar cotações de preço ajustadas ao risco.\n\n**Regras de tier:**\n- riskScore >= 75 → high (+8%)\n- riskScore >= 50 → medium (+3%)\n- riskScore < 50  → low (+0%)\n\n**Produção:** https://lf-worldbank-risk-pricing.onrender.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://lf-worldbank-risk-pricing.onrender.com",
      "type": "string"
    }
  ],
  "item": [
    {
